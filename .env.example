# Copy to .env and fill in. Names only — never commit values.

# Enables the agent stage. Without it, the deterministic rule engine runs alone and the
# application remains fully functional (plainer wording, identical verdicts and measurements).
ANTHROPIC_API_KEY=

# Only needed if the key above is organisation-scoped rather than workspace-scoped.
# Anthropic rejects such a request with "must include the anthropic-workspace-id header".
# Find it in the Anthropic Console URL when viewing a workspace.
ANTHROPIC_WORKSPACE_ID=

# Comma-separated CORS origins the API accepts. Default: http://localhost:3000
ALLOWED_ORIGINS=

# Backend URL the browser calls. Default: http://localhost:8000
NEXT_PUBLIC_API_URL=
